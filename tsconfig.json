{
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"./types/**/*",
		"**/*.js",
		".storybook/**/*.ts",
		".storybook/**/*.tsx",
		".storybook/**/*.js",
		"./vitest.setup.ts"
	],
	"exclude": ["node_modules", ".vscode", "storybook-static"],
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["dom", "dom.iterable", "ESNext"],
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"strict": true,
		"removeComments": true,
		"sourceMap": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"typeRoots": [
			"types/declarations.d.ts",
			"node_modules",
		],
		"rootDirs": [".", "./.react-router/types"],
		"types": ["vitest/globals"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"paths": {
			"@/*": ["./*"],
			"@/app/*": ["./app/*"],
			"@/public/*": ["./public/*"],
			"@/components/*": ["./components/*"],
			"@/theme/*": ["./theme/*"],
			"@/lib/*": ["./lib/*"],
			"@/mock/*": ["./mock/*"],
			"@/services/*": ["./services/*"]
		}
	}
}
